{
  "name": "json-sales-payload",
  "description": "Same redelivery cycle for a JSON payload: content published to topic1 on the 5th delivery is identical to what was sent.",
  "source": { "muleApp": "jms-message-rollback-and-redelivery", "flow": "JMSRedeliver", "evidence": "documented", "reference": "jms-message-rollback-and-redelivery/src/main/app/jms-redelivery.xml (no transformer between jms:inbound-endpoint and jms:outbound-endpoint topic=topic1)" },
  "send": [ { "destination": "queue:in", "body": "{\"ITEM_ID\":1,\"ITEM_NAME\":\"Shirt\",\"QTY\":1,\"PRICE\":20}" } ],
  "expectedMessages": [
    { "destination": "topic:topic1", "count": 1, "type": "TextMessage", "bodyFormat": "JSON", "body": { "ITEM_ID": 1, "ITEM_NAME": "Shirt", "QTY": 1, "PRICE": 20 } },
    { "destination": "queue:in", "count": 0 },
    { "destination": "queue:ActiveMQ.DLQ", "count": 0 }
  ],
  "expectedState": { "deliveryAttempts": [ {"deliveryCount":1,"outcome":"ROLLED_BACK"}, {"deliveryCount":2,"outcome":"ROLLED_BACK"}, {"deliveryCount":3,"outcome":"ROLLED_BACK"}, {"deliveryCount":4,"outcome":"ROLLED_BACK"}, {"deliveryCount":5,"outcome":"COMMITTED"} ], "minRedeliveryDelaysMillis": [5000, 2000, 2000, 2000] }
}
