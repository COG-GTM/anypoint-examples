{
  "name": "employees-json-converted-to-xml-and-uploaded",
  "description": "The README/IT sample JSON is converted to XML by the 'JSON to XML' DataWeave script; the flow replies with that XML and the same document is uploaded to /Upload/muleExample.xml.",
  "source": {
    "muleApp": "upload-to-ftp-after-converting-json-to-xml",
    "flow": "main",
    "evidence": "munit",
    "reference": "upload-to-ftp-after-converting-json-to-xml/src/test/java/org/mule/examples/UploadToFtpAfterConvertingJsonToXmlIT.java#testDataWeave (request src/test/resources/message.json, expected reply src/test/resources/reply.xml compared with whitespace removed); upload target from src/main/app/upload-to-ftp.xml ftp:outbound-endpoint path=\"/Upload/\" outputPattern=\"muleExample.xml\"; Content-Type from the DataWeave header '%output application/xml encoding=\"UTF-8\"'"
  },
  "request": {
    "method": "POST",
    "path": "/",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "employees": {
        "employee": [
          {
            "name": "John",
            "lastName": "Doe",
            "addresses": {
              "address": [
                {
                  "street": "123 Main Street",
                  "zipCode": "111"
                },
                {
                  "street": "987 Cypress Avenue",
                  "zipCode": "222"
                }
              ]
            }
          },
          {
            "name": "Jane",
            "lastName": "Doe",
            "addresses": {
              "address": [
                {
                  "street": "345 Main Street",
                  "zipCode": "111"
                },
                {
                  "street": "654 Sunset Boulevard",
                  "zipCode": "333"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "~application/xml; ?charset=UTF-8"
    },
    "bodyFormat": "XML",
    "body": "<?xml version='1.0' encoding='UTF-8'?><employees><employee><name>John</name><lastName>Doe</lastName><addresses><address><street>123 Main Street</street><zipCode>111</zipCode></address><address><street>987 Cypress Avenue</street><zipCode>222</zipCode></address></addresses></employee><employee><name>Jane</name><lastName>Doe</lastName><addresses><address><street>345 Main Street</street><zipCode>111</zipCode></address><address><street>654 Sunset Boulevard</street><zipCode>333</zipCode></address></addresses></employee></employees>"
  },
  "expectedUpload": {
    "path": "/Upload/muleExample.xml",
    "bodyFormat": "XML",
    "body": "<?xml version='1.0' encoding='UTF-8'?><employees><employee><name>John</name><lastName>Doe</lastName><addresses><address><street>123 Main Street</street><zipCode>111</zipCode></address><address><street>987 Cypress Avenue</street><zipCode>222</zipCode></address></addresses></employee><employee><name>Jane</name><lastName>Doe</lastName><addresses><address><street>345 Main Street</street><zipCode>111</zipCode></address><address><street>654 Sunset Boulevard</street><zipCode>333</zipCode></address></addresses></employee></employees>"
  }
}
