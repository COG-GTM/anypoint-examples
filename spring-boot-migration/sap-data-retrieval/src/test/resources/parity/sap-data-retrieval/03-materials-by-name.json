{
  "name": "materials-by-name",
  "description": "GET /api/materials?name=Test&max_count=5 sends BAPI_MATERIAL_GETLIST (MAXROWS=5, SIGN=I OPTION=CP DESCR_LOW='Test*') and returns the MATNRLIST rows as {\"materials\": [...]}.",
  "source": {
    "muleApp": "sap-data-retrieval",
    "flow": "get:/materials:sap-api-config",
    "evidence": "documented",
    "reference": "sap-data-retrieval/src/main/app/sap-api.xml (flow get:/materials:sap-api-config: DataWeave 'Transform Map to Xml<BAPI_MATERIAL_GETLIST>' MAXROWS + MATERIALSHORTDESCSEL I/CP/<name>*, functionName=BAPI_MATERIAL_GETLIST, 'materials: MATNRLIST.*row map {($$):$} when MATNRLIST != \"\" otherwise {message:\"No data found.\"}'); samples inboundProperties_1.dwl, BAPI_MATERIAL_GETLIST.xml"
  },
  "request": {
    "method": "GET",
    "path": "/api/materials?name=Test&max_count=5"
  },
  "downstream": [
    {
      "method": "POST",
      "urlPath": "/functions/BAPI_MATERIAL_GETLIST",
      "status": 200,
      "headers": {
        "Content-Type": "application/xml"
      },
      "bodyFile": "bodies/BAPI_MATERIAL_GETLIST.xml"
    }
  ],
  "expectedOutbound": [
    {
      "method": "POST",
      "urlPath": "/functions/BAPI_MATERIAL_GETLIST",
      "headers": {
        "Content-Type": "~application/xml.*",
        "Authorization": "Basic cGFyaXR5LXVzZXI6cGFyaXR5LXNlY3JldA==",
        "sap-client": "800",
        "sap-language": "EN"
      },
      "bodyFormat": "XML",
      "body": "<?xml version='1.0' encoding='UTF-8'?><BAPI_MATERIAL_GETLIST><import><MAXROWS>5</MAXROWS></import><tables><MATERIALSHORTDESCSEL><row><SIGN>I</SIGN><OPTION>CP</OPTION><DESCR_LOW>Test*</DESCR_LOW></row></MATERIALSHORTDESCSEL></tables></BAPI_MATERIAL_GETLIST>"
    }
  ],
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "~application/json.*"
    },
    "bodyFormat": "JSON",
    "body": {
      "materials": [
        {
          "MATERIAL": "M001",
          "MATL_DESC": "TestMaterial",
          "MATERIAL_EXTERNAL": "MatEXT",
          "MATERIAL_GUID": "MatGUID",
          "MATERIAL_VERSION": "MatVersion"
        }
      ]
    }
  }
}