{
  "name": "customers-without-name",
  "description": "Without 'name' the selection value is the wildcard '*'.",
  "source": {
    "muleApp": "sap-data-retrieval",
    "flow": "get:/customers:sap-api-config",
    "evidence": "documented",
    "reference": "sap-data-retrieval/src/main/app/sap-api.xml (flow get:/customers:sap-api-config: DataWeave 'Transform Map to Xml<BAPI_CUSTOMER_FIND>', sap:outbound-endpoint functionName=BAPI_CUSTOMER_FIND xmlVersion=2, DataWeave 'customers: RESULT_TAB.*row map {($$):$}'); samples src/test/resources/sample_data/inboundProperties.dwl, BAPI_CUSTOMER_FIND.xml (FIELDVALUE ... otherwise \"*\")"
  },
  "request": {
    "method": "GET",
    "path": "/api/customers?max_count=10"
  },
  "downstream": [
    {
      "method": "POST",
      "urlPath": "/functions/BAPI_CUSTOMER_FIND",
      "status": 200,
      "headers": {
        "Content-Type": "application/xml"
      },
      "bodyFile": "bodies/BAPI_CUSTOMER_FIND.xml"
    }
  ],
