{
  "name": "materials-multiple-rows",
  "description": "Without 'name' DESCR_LOW is '*'; every MATNRLIST row is returned in order, empty fields as \"\" and XML entities decoded.",
  "source": {
    "muleApp": "sap-data-retrieval",
    "flow": "get:/materials:sap-api-config",
    "evidence": "documented",
    "reference": "sap-data-retrieval/src/main/app/sap-api.xml (flow get:/materials:sap-api-config: DataWeave 'Transform Map to Xml<BAPI_MATERIAL_GETLIST>' MAXROWS + MATERIALSHORTDESCSEL I/CP/<name>*, functionName=BAPI_MATERIAL_GETLIST, 'materials: MATNRLIST.*row map {($$):$} when MATNRLIST != \"\" otherwise {message:\"No data found.\"}'); samples inboundProperties_1.dwl, BAPI_MATERIAL_GETLIST.xml"
  },
  "request": {
    "method": "GET",
    "path": "/api/materials?max_count=2"
  },
  "downstream": [
    {
      "method": "POST",
      "urlPath": "/functions/BAPI_MATERIAL_GETLIST",
      "status": 200,
      "headers": {
        "Content-Type": "application/xml"
      },
      "bodyFile": "bodies/BAPI_MATERIAL_GETLIST-two-rows.xml"
    }
  ],
  "expectedOutbound": [
    {
      "method": "POST",
      "urlPath": "/functions/BAPI_MATERIAL_GETLIST",
      "headers": {
        "Content-Type": "~application/xml.*",
        "Authorization": "Basic cGFyaXR5LXVzZXI6cGFyaXR5LXNlY3JldA==",
        "sap-client": "800",
        "sap-language": "EN"
      },
      "bodyFormat": "XML",
      "body": "<?xml version='1.0' encoding='UTF-8'?><BAPI_MATERIAL_GETLIST><import><MAXROWS>2</MAXROWS></import><tables><MATERIALSHORTDESCSEL><row><SIGN>I</SIGN><OPTION>CP</OPTION><DESCR_LOW>*</DESCR_LOW></row></MATERIALSHORTDESCSEL></tables></BAPI_MATERIAL_GETLIST>"
    }
  ],
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "~application/json.*"
    },
    "bodyFormat": "JSON",
    "body": {
      "materials": [
        {
          "MATERIAL": "M001",
          "MATL_DESC": "Steel bolt M8",
          "MATERIAL_EXTERNAL": "",
          "MATERIAL_GUID": "",
          "MATERIAL_VERSION": ""
        },
        {
          "MATERIAL": "M002",
          "MATL_DESC": "Steel nut M8 & washer",
          "MATERIAL_EXTERNAL": "",
          "MATERIAL_GUID": "",
          "MATERIAL_VERSION": ""
        }
      ]
    }
  }
}