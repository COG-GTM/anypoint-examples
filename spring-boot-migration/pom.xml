    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>org.mule.examples.springboot</groupId>
    <artifactId>spring-boot-migration</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Anypoint examples :: Spring Boot 3 migration (parent)</name>
    <description>Spring Boot 3 / Java 17 re-implementations of the Mule 3.8 examples in this repository, each with parity tests.</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.6.0</springdoc.version>
        <wiremock.version>3.9.1</wiremock.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <!-- 1.21.4+ speaks Docker API >= 1.44 (required by Docker Engine 29+); Boot 3.3.4 manages 1.19.8 -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <parity-test-support.version>${project.version}</parity-test-support.version>
    </properties>

    <!--
      Always-built modules. Migrated app modules are NOT listed here: each one is
      enabled by the file-activated profile below as soon as <app>/pom.xml exists,
      so parallel tickets never have to edit this file (and never conflict on it).
    -->
    <modules>
        <module>parity-test-support</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mule.examples.springboot</groupId>
                <artifactId>parity-test-support</artifactId>
                <version>${parity-test-support.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Parity tests are ordinary JUnit 5 tests so `mvn verify` always runs them. -->
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*ParityTest.java</include>
                        </includes>
                        <systemPropertyVariables>
                            <parity.mule.base-url>${parity.mule.base-url}</parity.mule.base-url>
                            <parity.record>${parity.record}</parity.record>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

