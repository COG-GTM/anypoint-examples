{
  "name": "05-paged-result-takes-max-over-all-pages",
  "description": "A result split over two pages (nextRecordsUrl, as the connector's paging iterator follows): every record from both pages is processed and the watermark is the MAX over all of them, not just the first page.",
  "given": {
    "watermark": "2015-06-17T09:00:00.000Z"
  },
  "source": {
    "muleApp": "salesforce-data-synchronization-using-watermarking-and-batch-processing",
    "flow": "triggerFlow",
    "evidence": "documented",
    "reference": "salesforce-data-synchronization-using-watermarking-and-batch-processing/src/main/app/watermarking.xml (flow triggerFlow: poll fixed-frequency 10 s, watermark variable=timestamp default-expression=YESTERDAY selector=MAX selector-expression=#[payload.LastModifiedDate], sfdc:query 'SELECT Id,Name,LastModifiedDate FROM Contact WHERE LastModifiedDate > #[flowVars['timestamp']]'; batch:job watermarkingBatch Batch_Step logger 'Contact recently modified: #[payload]'); README 'How it Works'"
  },
  "request": {
    "method": "POLL",
    "path": "triggerFlow"
  },
  "downstream": [
