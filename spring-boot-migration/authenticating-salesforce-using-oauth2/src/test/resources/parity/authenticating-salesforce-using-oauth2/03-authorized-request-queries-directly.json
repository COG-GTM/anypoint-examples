      "urlPath": "/services/data/v61.0/query",
      "queryParams": {
        "q": "SELECT id,lastname,lastmodifieddate from contact limit 10"
      },
      "count": 1,
      "headers": {
        "Authorization": "Bearer 00Dparity!STORED"
      }
    }
  ],
  "expected": {
    "status": 200,
    "bodyFormat": "TEXT",
    "body": "Salesforce query returned 3 contacts."
  }
