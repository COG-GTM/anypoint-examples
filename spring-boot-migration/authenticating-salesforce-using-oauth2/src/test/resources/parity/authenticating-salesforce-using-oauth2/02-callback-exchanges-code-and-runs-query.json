{
  "name": "02-callback-exchanges-code-and-runs-query",
  "description": "Salesforce redirects back to /oauth2callback with the authorization code and the state from the redirect: the code is exchanged at accessTokenUrl (authorization_code grant with consumer key/secret and the same redirect_uri), then the rest of the flow runs with the new token: the fixed SOQL query and 'Salesforce query returned N contacts.' (SalesforceOauthIT expects the page to contain 'Salesforce query returned').",
  "given": {
    "authorized": false,
    "pendingState": "parity-state-1"
  },
  "source": {
    "muleApp": "authenticating-salesforce-using-oauth2",
    "flow": "salesforce-oauthFlow1",
    "evidence": "documented",
    "reference": "authenticating-salesforce-using-oauth2/src/main/app/salesforce-oauth.xml (sfdc:config-with-oauth consumerKey=${sfdc.key}, oauth-callback-config domain=localhost localPort=8081 path=oauth2callback; flow salesforce-oauthFlow1: sfdc:authorize authorizationUrl/accessTokenUrl display=PAGE, sfdc:query, foreach logger 'contact: #[payload]', set-payload 'Salesforce query returned #[payload.size()] contacts.')"
  },
  "request": {
    "method": "GET",
    "path": "/oauth2callback?code=aPrxparityAuthCode%3D%3D&state=parity-state-1"
  },
  "downstream": [
    {
      "method": "POST",
      "urlPath": "/services/oauth2/token",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "access_token": "00Dparity!OAUTH",
        "refresh_token": "5Aepparity-refresh",
        "signature": "c2lnbmF0dXJl",
        "scope": "full refresh_token",
        "instance_url": "{{downstream.base-url}}",
        "id": "https://login.salesforce.com/id/00Dparity/005parity",
        "token_type": "Bearer",
        "issued_at": "1414414165000"
      }
    },
    {
      "method": "GET",
      "urlPath": "/services/data/v61.0/query",
      "queryParams": {
        "q": "SELECT id,lastname,lastmodifieddate from contact limit 10"
      },
      "status": 200,
