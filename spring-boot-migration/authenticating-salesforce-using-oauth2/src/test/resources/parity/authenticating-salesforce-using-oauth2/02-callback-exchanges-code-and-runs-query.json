      "bodyFormat": "TEXT",
      "body": "grant_type=authorization_code&code=aPrxparityAuthCode%3D%3D&client_id=parity-consumer-key&client_secret=parity-consumer-secret&redirect_uri=http%3A%2F%2Flocalhost%3A8081%2Foauth2callback"
