{
  "name": "username-token-wrong-password",
  "description": "UsernameToken with a wrong password is rejected with a SOAP fault mentioning the security token.",
  "source": {
    "muleApp": "soap-webservice-security",
    "flow": "UsernameTokenServiceFlow",
    "evidence": "documented",
    "reference": "soap-webservice-security/src/test/java/com/mulesoft/mule/example/security/SoapWebserviceSecurityIT.java#testUsernameTokenWrongPasswordError (fault message contains \"security token\")"
  },
  "request": {
    "method": "POST",
    "path": "/services/username",
    "headers": {
      "Content-Type": "text/xml;charset=UTF-8",
      "SOAPAction": "\"\"",
      "X-Parity-WSS": "usernameTokenWrongPassword"
    },
    "bodyFile": "bodies/greet-request.xml"
  },
  "expected": {
    "status": 500,
    "headers": {
      "Content-Type": "~text/xml.*"
    },
    "bodyFormat": "XML",
    "bodyFile": "bodies/fault-failed-authentication.xml"
  }
}
