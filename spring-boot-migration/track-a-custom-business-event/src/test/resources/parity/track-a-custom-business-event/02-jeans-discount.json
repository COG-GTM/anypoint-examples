{
  "name": "02-jeans-discount",
  "description": "Jeans get a 20% discount: 10 * (1 - 0.2) = 8.0 (a JRuby Float, so object-to-string prints 8.0).",
  "source": {
    "muleApp": "track-a-custom-business-event",
    "flow": "custom-business-eventsFlow1",
    "evidence": "documented",
    "reference": "track-a-custom-business-event/src/main/app/custom-business-events.xml (jruby when \"jeans\" $discount = 0.2; object-to-string-transformer)"
  },
  "request": {
    "method": "POST",
    "path": "/customBusinessEvents",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "email": "aaa@abc.sk",
      "item name": "jeans",
      "item units": 1,
      "item price per unit": 10,
      "membership": "free"
    }
  },
  "expected": {
    "status": 200,
    "bodyFormat": "TEXT",
    "body": "8.0"
  },
  "expectedEvents": [
    {
      "name": "Price",
      "transactionId": "custom-business-event-example-transaction",
      "metadata": {
        "item name": "jeans",
        "item units": "1",
        "item price per unit": "10"
      }
    }
  ]
}
