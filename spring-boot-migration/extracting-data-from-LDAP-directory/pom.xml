<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.mule.examples.springboot</groupId>
        <artifactId>spring-boot-migration</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>extracting-data-from-LDAP-directory</artifactId>
    <name>Anypoint examples :: Spring Boot migration :: extracting-data-from-LDAP-directory</name>
    <description>HTTP endpoint that lists the entries under ou=people of an LDAP directory (Spring LDAP).</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-ldap</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mule.examples.springboot</groupId>
            <artifactId>parity-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Embedded LDAP server for parity tests (the Mule IT uses the same UnboundID in-memory server). -->
        <dependency>
            <groupId>com.unboundid</groupId>
            <artifactId>unboundid-ldapsdk</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
