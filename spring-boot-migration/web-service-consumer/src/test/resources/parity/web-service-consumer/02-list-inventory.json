{
  "name": "list-inventory",
  "description": "POST /inventory invokes ListInventory (generated empty request, SOAPAction list-inventory) and returns payload.ns0#ListInventoryResponse as JSON. DataWeave 1.0 keeps every repeated <inventory> element as a repeated \"inventory\" key, so the body is compared as text (a JSON parser would drop the duplicates).",
  "source": {
    "muleApp": "web-service-consumer",
    "flow": "listInventory",
    "evidence": "documented",
    "reference": "web-service-consumer/src/main/app/tshirt-service-consumer.xml (ws:consumer operation=ListInventory; dw %output application/json payload.ns0#ListInventoryResponse); tshirt.wsdl (ListInventory empty sequence, soapAction list-inventory); sample_data/ListInventoryResponse.xml; WebServiceConsumerIT asserts '\"productCode\": \"1412\"', '\"description\": \"Prueba2\"', '\"count\": \"5\"'"
  },
  "request": {
    "method": "POST",
    "path": "/inventory",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "downstream": [
    {
      "method": "POST",
      "urlPath": "/",
      "status": 200,
      "headers": {
        "Content-Type": "text/xml;charset=UTF-8"
      },
      "bodyFile": "bodies/list-inventory-response.xml"
    }
  ],
  "expectedOutbound": [
    {
      "method": "POST",
      "urlPath": "/",
      "headers": {
        "Content-Type": "~text/xml.*",
        "SOAPAction": "~\"?http://mulesoft\\.org/tshirt-service/list-inventory\"?"
