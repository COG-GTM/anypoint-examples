      "bodyFile": "bodies/list-inventory-request.xml"
    }
  ],
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "~application/json.*"
    },
    "bodyFormat": "TEXT",
    "body": "~\\s*\\{\\s*\"inventory\":\\s*\\{\\s*\"productCode\":\\s*\"4102\",\\s*\"size\":\\s*\"L\",\\s*\"description\":\\s*\"Prueba\",\\s*\"count\":\\s*\"2\"\\s*\\},\\s*\"inventory\":\\s*\\{\\s*\"productCode\":\\s*\"1412\",\\s*\"size\":\\s*\"L\",\\s*\"description\":\\s*\"Foo\",\\s*\"count\":\\s*\"9\"\\s*\\},\\s*\"inventory\":\\s*\\{\\s*\"productCode\":\\s*\"5656\",\\s*\"size\":\\s*\"S\",\\s*\"description\":\\s*\"Bar\",\\s*\"count\":\\s*\"2\"\\s*\\},\\s*\"inventory\":\\s*\\{\\s*\"productCode\":\\s*\"5657\",\\s*\"size\":\\s*\"M\",\\s*\"description\":\\s*\"Prueba2\",\\s*\"count\":\\s*\"3\"\\s*\\},\\s*\"inventory\":\\s*\\{\\s*\"productCode\":\\s*\"1411\",\\s*\"size\":\\s*\"M\",\\s*\"description\":\\s*\"Awesome\\ Tshirt\",\\s*\"count\":\\s*\"5\"\\s*\\}\\s*\\}\\s*"
